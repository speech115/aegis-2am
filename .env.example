# === Sponsor Stack Keys ===
# Daytona Cloud Sandboxes (https://app.daytona.io) — enables real cloud dual-sandbox verification
DAYTONA_API_KEY=
DAYTONA_TARGET=eu

# Cognition Devin API (optional — triggers live Devin remediation session)
DEVIN_API_KEY=

# Optional LLM for dynamic patch synthesis (falls back to verified deterministic patches offline)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional GitHub token for live PR creation (otherwise uses local `gh` CLI auth)
GITHUB_TOKEN=
GITHUB_REPO=speech115/aegis-2am

# Server config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://aegis-2am.vercel.app
